<Window x:Class="ZhenhuaDiskCleaner.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:ZhenhuaDiskCleaner.Helpers"
        xmlns:models="clr-namespace:ZhenhuaDiskCleaner.Models"
        Title="关于"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Window.Resources>
        <!-- 顶部色带：主题紫 → 深一档的紫（和主界面的强调色同源） -->
        <LinearGradientBrush x:Key="AboutHeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
            <GradientStop Color="#4A44BB" Offset="1"/>
        </LinearGradientBrush>

        <!-- 信息行的三件套：图标 / 名称 / 值 -->
        <Style x:Key="IconTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 值文本：是链接（AboutInfoItem.IsLink）才上色 + 下划线 + 手型 -->
        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLink}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="ToolTip" Value="点击打开"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        外层留白既是投影的容身之处，也是「点卡片外关闭」的命中区。
        （旧的代码版把卡片 Border 直接当 Window.Content 铺满整个窗口，
          ev.Source == dlg 永远不成立，「点外部关闭」其实从来没生效过。）
    -->
    <Grid Background="Transparent" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">

        <Border x:Name="Card" Margin="22" CornerRadius="12"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="16"
                                  ShadowDepth="3" Direction="270"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── 顶部色带：图标 + 名称 + 版本（版本号来自程序集，见 AppInfo） ── -->
                <Border x:Name="Header" Grid.Row="0" CornerRadius="12,12,0,0"
                        Padding="24,18,14,18" Background="{StaticResource AboutHeaderBrush}"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                                    Background="#3CFFFFFF">
                                <TextBlock Text="⚡" FontSize="22" FontFamily="Segoe UI Emoji"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static helpers:AppInfo.Name}"
                                           FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{x:Static helpers:AppInfo.Subtitle}"
                                           FontSize="11" Foreground="#B4FFFFFF" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右上角关闭（底部的「关闭」按钮兼任 Esc 取消键） -->
                        <Button Content="✕" Width="26" Height="26" Padding="0" FontSize="13"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#B4FFFFFF" Cursor="Hand" ToolTip="关闭"
                                Click="Close_Click"/>
                    </Grid>
                </Border>

                <!-- ── 内容区：四行信息 + 版权 ── -->
                <StackPanel Grid.Row="1" Margin="24,18,24,10">
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                               Style="{StaticResource IconTextStyle}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}"
                                               Style="{StaticResource LabelTextStyle}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}"
                                               Style="{StaticResource ValueTextStyle}"
                                               MouseLeftButtonUp="Value_MouseLeftButtonUp"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <models:AboutInfoItem Icon="🌐" Label="官方网站" Value="{x:Static helpers:AppInfo.Website}"/>
                        <models:AboutInfoItem Icon="📧" Label="联系邮箱" Value="{x:Static helpers:AppInfo.Email}"/>
                        <models:AboutInfoItem Icon="📝" Label="开源协议" Value="{x:Static helpers:AppInfo.License}"/>
                        <models:AboutInfoItem Icon="🛡" Label="系统要求" Value="{x:Static helpers:AppInfo.Requirements}"/>
                    </ItemsControl>

                    <TextBlock Text="{x:Static helpers:AppInfo.Copyright}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- ── 底部：关闭（IsCancel → Esc 也能关，IsDefault → 回车也能关） ── -->
                <Border Grid.Row="2" Padding="24,10,24,16"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Button Content="关闭" Width="80" Height="30" Padding="0" FontSize="12"
                            HorizontalAlignment="Right" Cursor="Hand"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True" IsCancel="True"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
